{
  "name": "winden",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "npm-run-all --parallel start:admin start:compiler",
    "-------": " ",
    "start": "npm-run-all --parallel start:admin start:autocomplete start:compiler",
    "start:admin": "node configs/esbuild.admin.config.js --watch",
    "start:autocomplete": "node configs/esbuild.autocomplete.config.js --watch",
    "start:compiler": "node configs/esbuild.compiler.config.mjs --watch",
    "------": " ",
    "build": "rm -rf build && npm-run-all build:scss --parallel build:admin build:autocomplete build:compiler build:html-editor",
    "-----": " ",
    "build:admin": "NODE_ENV=production node configs/esbuild.admin.config.js",
    "build:autocomplete": "NODE_ENV=production node configs/esbuild.autocomplete.config.js",
    "build:compiler": "node configs/esbuild.compiler.config.mjs",
    "build:scss": "node configs/build-scss.js",
    "----": " ",
    "check-updates": "npm outdated",
    "update": "npx npm-check-updates -u && npm install",
    "clean:ds": "find . -name '.DS_Store' -type f -delete",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lint": "eslint src/winden-classes src/plain-classes/shared src/blocks --max-warnings 4",
    "lint:all": "eslint .",
    "typecheck": "tsc -p tsconfig.check.json --noEmit",
    "typecheck:all": "tsc --noEmit",
    "lint:php": "find App pro/App -name \"*.php\" -print0 | xargs -0 -n1 php -l | grep -v \"No syntax errors\" || true",
    "validate": "npm run lint && npm run typecheck && npm run test && npm run build:autocomplete",
    "build:html-editor": "NODE_ENV=production node configs/esbuild.html-editor.config.js"
  },
  "files": [
    "*"
  ],
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-query-devtools": "^5.91.3",
    "@uiw/color-convert": "^2.9.5",
    "@uiw/react-color": "^2.9.5",
    "autoprefixer": "^10.4.27",
    "axios": "^1.13.5",
    "class-variance-authority": "^0.7.1",
    "classnames": "^2.5.1",
    "clsx": "^2.1.1",
    "color-2-name": "^1.5.2",
    "emmet-monaco-es": "^5.7.0",
    "immutable": "^5.1.4",
    "lodash": "^4.17.23",
    "monaco-editor": "^0.56.0",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sass.js": "^0.11.1",
    "tailwind-merge": "^3.6.0",
    "tinycolor2": "^1.6.0",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/browser": "^4.3.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/tinycolor2": "^1.4.6",
    "chokidar": "^4.0.3",
    "esbuild": "^0.28.2",
    "esbuild-plugin-copy": "^2.1.1",
    "esbuild-plugin-inline-import": "^1.1.0",
    "esbuild-plugin-polyfill-node": "^0.3.0",
    "esbuild-sass-plugin": "^3.6.0",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "jsdom": "^28.1.0",
    "lucide-static": "^1.31.0",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.3.3",
    "terser": "^5.46.0",
